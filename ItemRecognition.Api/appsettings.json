{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GigaChat": {
    "Provider": "gigachat",
    "Model": "GigaChat-2-Max",
    "Scope": "GIGACHAT_API_PERS",
    "AuthorizationKey": "",
